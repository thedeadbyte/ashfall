# Ghostty config shipped by ashfall.
# To customize, copy this file into your config repo and set
# ashfall.dev.ghostty.config to it.

font-family = "JetBrainsMono Nerd Font"
font-size = 12
theme = TokyoNight
window-padding-x = 8
window-padding-y = 8
cursor-style = block
mouse-hide-while-typing = true
copy-on-select = clipboard
confirm-close-surface = false
shell-integration = detect
